{
  "name": "couchmode",
  "version": "0.1.0",
  "private": true,
  "description": "Your coding agent, in couch mode. An Agent Client Protocol (ACP) client for the TV.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @couchmode/bridge run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dev:fake": "pnpm --filter @couchmode/bridge run dev -- --fake",
    "check": "pnpm typecheck && pnpm --filter @couchmode/bridge run check:hub && pnpm --filter @couchmode/web run check:render",
    "check:tv": "pnpm build && pnpm --filter @couchmode/web run check:tv"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}

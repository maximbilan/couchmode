<?xml version="1.0" encoding="utf-8"?>
<!--
  Fire OS draws a sideloaded app's home-screen tile as a square slot on its own
  grey plate unless the icon is adaptive. With an adaptive icon the launcher
  has a background layer it can extend across the whole 16:9 tile, which is why
  every Appstore app's tile is a solid brand-coloured rectangle.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

<?xml version="1.0" encoding="utf-8"?>
<!--
  First-run form. Plain EditTexts because they are already D-pad friendly:
  the remote moves between fields and OK opens the system keyboard.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="96dp"
        android:paddingVertical="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_title"
            android:textColor="@color/muted"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/setupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/danger"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/setup_host_label"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="no"
            android:background="@drawable/field_background"
            android:hint="@string/setup_host_hint"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusDown="@id/codeInput"
            android:nextFocusUp="@id/hostInput"
            android:minHeight="64dp"
            android:paddingHorizontal="20dp"
            android:textColor="@color/text"
            android:textColorHint="@color/line"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_code_label"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="no"
            android:background="@drawable/field_background"
            android:hint="@string/setup_code_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1"
            android:nextFocusDown="@id/connectButton"
            android:nextFocusUp="@id/hostInput"
            android:minHeight="64dp"
            android:paddingHorizontal="20dp"
            android:textColor="@color/text"
            android:textColorHint="@color/line"
            android:textSize="24sp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="64dp"
            android:nextFocusUp="@id/codeInput"
            android:text="@string/setup_connect"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_hint"
            android:textColor="@color/muted"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Border brightens on focus, matching the web client's focus treatment. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_2" />
            <stroke android:width="3dp" android:color="@color/focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="2dp" android:color="@color/line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
